.page { padding: 0 24rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.hero { height: 324rpx; position: relative; overflow: hidden; }
.hero-copy { position: relative; z-index: 1; padding: 72rpx 0 0 24rpx; }
.brand { display: block; font-size: 29rpx; line-height: 1.4; font-weight: 700; }
.hero-title { display: block; font-size: 68rpx; line-height: 1.12; font-weight: 800; letter-spacing: 1rpx; margin-top: 6rpx; }
.underline { position: relative; overflow: hidden; width: 252rpx; height: 24rpx; margin-top: 2rpx; }
.underline-source { position: absolute; width: 750rpx; height: 1584rpx; left: -59rpx; top: -283rpx; }
.cat { position: absolute; right: -4rpx; top: 8rpx; width: 310rpx; height: 310rpx; }
.card { background: rgba(255,255,255,.94); border: 2rpx solid #d7e2eb; border-radius: 24rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.section-title { display: block; font-size: 38rpx; line-height: 1.25; font-weight: 700; margin-bottom: 8rpx; }
.row { display: flex; align-items: center; margin-top: 16rpx; gap: 16rpx; }
.section-title + .row { margin-top: 14rpx; }
.label { width: 136rpx; flex-shrink: 0; font-size: 28rpx; line-height: 1.35; }
.control { flex: 1; min-width: 0; }
.date-field, .field { background: #fff; border: 2rpx solid #d5e0eb; border-radius: 12rpx; min-height: 84rpx; padding: 0 18rpx; font-size: 30rpx; line-height: 1.35; }
.date-default { color: #606b7d; }
.date-field { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.calendar { width: 29rpx; height: 30rpx; border: 3rpx solid #7791ab; border-radius: 5rpx; position: relative; flex-shrink: 0; }
.calendar::before, .calendar::after { content: ''; position: absolute; top: -7rpx; width: 3rpx; height: 10rpx; background: #7791ab; }
.calendar::before { left: 5rpx; } .calendar::after { right: 5rpx; }
.calendar-line { border-top: 3rpx solid #7791ab; margin-top: 7rpx; }
.nights-row { align-items: flex-start; } .nights-row > .label { padding-top: 22rpx; }
.night-options { display: flex; gap: 12rpx; }
.night { flex: 1; width: 0; min-width: 0; margin: 0; padding: 0; height: 84rpx; line-height: 80rpx; background: #fff; border: 2rpx solid #d5e0eb; font-size: 30rpx; }
.night.selected { border-color: #a4c9ec; background: #c2dff7; color: rgba(64, 44, 37, .82); }
.stay-summary { display: flex; align-items: center; justify-content: center; min-height: 60rpx; background: #edf7ff; border-radius: 12rpx; padding: 8rpx 12rpx; color: rgba(64, 44, 37, .76); font-size: 27rpx; line-height: 1.35; text-align: center; margin-top: 8rpx; }
.stepper { display: flex; height: 46px; border: 2rpx solid #d5e0eb; border-radius: 12rpx; overflow: hidden; }
.page .stepper button { background: #fff; flex: 0 0 44px; width: 44px; height: 44px; margin: 0; padding: 0; line-height: 44px; color: #7791ab; font-size: 42rpx; border-radius: 0; }
.stepper button[disabled] { color: #bdcbd7; background: #f8fafc; }
.stepper text { width: 88rpx; text-align: center; line-height: 44px; border-left: 2rpx solid #d5e0eb; border-right: 2rpx solid #d5e0eb; font-size: 30rpx; font-variant-numeric: tabular-nums; }
.room-note { display: block; margin: 8rpx 0 0 152rpx; font-size: 23rpx; line-height: 1.45; color: #606b7d; }
.capacity-error { margin-left: 152rpx; }
.placeholder { color: #606b7d; font-family: "LemiMilkFoam", sans-serif; font-size: 24rpx; font-weight: normal; }
.form-row { align-items: flex-start; }
.form-row > .label { padding-top: 23rpx; }
.required { margin-left: 4rpx; color: #b85c52; }
.form-control .field { width: 100%; }
.field-invalid { border-color: #b85c52; }
.error-text { display: block; margin: 8rpx 0 0; color: #9f433b; font-size: 24rpx; line-height: 1.4; }
.error-text.capacity-error { margin-left: 152rpx; }
.notes-row { align-items: flex-start; } .notes-row .label { padding-top: 18rpx; }
.optional { display: block; font-size: 23rpx; line-height: 1.35; }
.notes { height: 126rpx; padding-top: 16rpx; line-height: 1.55; }
.primary { background: #b6d8f5; color: rgba(64, 44, 37, .88); font-size: 30rpx; font-weight: 700; height: 88rpx; line-height: 88rpx; border-radius: 14rpx; margin-top: 24rpx; }
.primary:active, .night:active { opacity: .8; }
.footnote { text-align: center; font-size: 23rpx; line-height: 1.55; color: #606b7d; margin-top: 12rpx; }
.confirmation-note { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #edf7ff; color: #4e6175; font-size: 25rpx; line-height: 1.5; text-align: center; }
.demo-note { display: block; text-align: center; color: #606b7d; font-size: 21rpx; line-height: 1.45; margin-top: 4rpx; }
.overlay { position: fixed; z-index: 10; inset: 0; background: rgba(41,37,35,.35); display: flex; align-items: flex-end; }
.sheet { background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 30rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); width: 100%; }
.sheet-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.calendar-sheet .sheet-heading { margin-bottom: 24rpx; }
.sheet .sheet-heading button.close { flex: 0 0 44px; width: 44px; min-width: 0; height: 44px; margin: 0; padding: 0; line-height: 44px; background: #f0f6fa; font-size: 40rpx; border-radius: 8rpx; }
.review-body { max-height: 48vh; }
.review-row { display: flex; gap: 24rpx; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #edf1f5; font-size: 28rpx; line-height: 1.45; }
.review-row > text:first-child { color: #606b7d; flex-shrink: 0; }
.review-row > text:last-child { text-align: right; word-break: break-all; white-space: pre-wrap; }
.review-stay { background: #edf7ff; padding: 16rpx 18rpx; border-radius: 12rpx; font-size: 27rpx; line-height: 1.45; margin-top: 14rpx; }
.review-notice { font-size: 23rpx; line-height: 1.5; color: #606b7d; text-align: center; margin-top: 24rpx; }
.review-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.review-actions button { flex: 1; min-width: 0; height: 88rpx; margin: 0; line-height: 84rpx; border-radius: 14rpx; font-size: 29rpx; }
.review-actions .secondary { background: #fff; border: 2rpx solid #b6d8f5; color: #402c25; }
.review-actions .primary { margin: 0; }

.page button.date-trigger { display: block; width: 100%; min-width: 0; margin: 0; padding: 0; border: 0; background: transparent; text-align: left; line-height: normal; }
.page button.date-trigger::after { border: 0; }
.month-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.sheet .month-nav button { flex: 0 0 44px; width: 44px; min-width: 0; height: 44px; margin: 0; padding: 0; line-height: 44px; background: #f0f6fa; color: #7791ab; font-size: 40rpx; border-radius: 8rpx; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.weekdays text, .day-cell { width: 14.285714%; text-align: center; }
.weekdays { color: #606b7d; font-size: 24rpx; margin-bottom: 10rpx; }
.day-cell { height: 44px; display: flex; align-items: center; justify-content: center; }
.sheet .calendar-grid button.day { flex: 1; width: 100%; min-width: 0; height: 44px; margin: 0; padding: 0; line-height: 44px; background: transparent; border: 2rpx solid transparent; border-radius: 6rpx; }
.sheet .calendar-grid button.day { position: relative; border: 0; z-index: 0; }
.sheet .calendar-grid button.day-disabled { color: #aeb8c2; }
.sheet .calendar-grid button.day-selected { font-weight: 700; }
.sheet .calendar-grid button.day-selected::before { content: ''; position: absolute; z-index: -1; width: 32px; height: 32px; left: 50%; top: 50%; transform: translate(-50%, -50%); box-sizing: border-box; border: 1px solid #8fbee9; border-radius: 3px; background: #edf7ff; }
.calendar-body { height: 290px; max-height: 42vh; }
.calendar-selection { color: #606b7d; font-size: 23rpx; line-height: 1.5; margin-top: 18rpx; }
.calendar-error { margin-top: 8rpx; }
.date-field, .night, .stay-summary, .stepper, .calendar-grid, .review-row { font-variant-numeric: tabular-nums; }

@media (max-width: 340px) {
  .page { padding-left: 20rpx; padding-right: 20rpx; }
  .hero { height: 296rpx; }
  .hero-copy { padding: 60rpx 0 0 18rpx; }
  .brand { font-size: 27rpx; }
  .hero-title { font-size: 60rpx; }
  .underline { width: 230rpx; }
  .cat { width: 280rpx; height: 280rpx; right: -16rpx; }
  .card { padding: 24rpx 20rpx; }
  .section-title { font-size: 36rpx; }
  .row { gap: 12rpx; }
  .label { width: 124rpx; font-size: 27rpx; }
  .date-field, .field { padding-left: 14rpx; padding-right: 14rpx; font-size: 28rpx; }
  .night { font-size: 29rpx; }
  .room-note { margin-left: 136rpx; }
  .error-text.capacity-error { margin-left: 136rpx; }
}
