.page { min-height: 100vh; padding: 24rpx 24rpx 36rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.status-block { min-height: 244rpx; position: relative; display: flex; align-items: center; padding: 12rpx 6rpx 24rpx 24rpx; overflow: hidden; }
.status-copy { position: relative; z-index: 1; width: 60%; }
.status-mark { width: 58rpx; height: 58rpx; border: 6rpx solid #7faee0; border-radius: 50%; position: relative; margin-bottom: 12rpx; }
.status-check { position: absolute; left: 15rpx; top: 12rpx; width: 26rpx; height: 14rpx; border-left: 6rpx solid #7faee0; border-bottom: 6rpx solid #7faee0; transform: rotate(-45deg); }
.status-title { display: block; font-size: 46rpx; line-height: 1.2; font-weight: 700; }
.status-description { display: block; margin-top: 8rpx; color: #59677a; font-size: 25rpx; line-height: 1.45; }
.status-badge { display: inline-block; margin-top: 12rpx; padding: 8rpx 17rpx; border-radius: 999rpx; background: #dceefe; color: #2e658f; font-size: 23rpx; line-height: 1.3; }
.chick { position: absolute; z-index: 0; width: 282rpx; height: 282rpx; right: 16rpx; bottom: -7rpx; }

.voucher { background: rgba(255,255,255,.96); border: 2rpx solid #d7e2eb; border-radius: 24rpx; padding: 32rpx 30rpx 30rpx; }
.voucher-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.voucher-title { font-size: 37rpx; line-height: 1.25; font-weight: 700; }
.voucher-number { max-width: 58%; color: #667487; font-size: 22rpx; line-height: 1.35; text-align: right; word-break: break-all; font-variant-numeric: tabular-nums; }
.date-range { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding: 24rpx 4rpx; border-top: 1rpx solid #e4ebf1; border-bottom: 1rpx solid #e4ebf1; }
.date-range > view { min-width: 0; }
.date-caption { display: block; color: #667487; font-size: 23rpx; margin-bottom: 6rpx; }
.date-main { display: block; font-size: 39rpx; line-height: 1.2; font-variant-numeric: tabular-nums; }
.date-end { text-align: right; }
.date-arrow { flex: 0 0 88rpx; padding: 0 12rpx; }
.arrow-line { height: 2rpx; background: #8da8bf; position: relative; }
.arrow-line::after { content: ''; position: absolute; right: 0; top: -6rpx; width: 12rpx; height: 12rpx; border-top: 2rpx solid #8da8bf; border-right: 2rpx solid #8da8bf; transform: rotate(45deg); }
.stay-facts { display: flex; align-items: center; justify-content: center; gap: 18rpx; min-height: 82rpx; color: #3f5265; font-size: 28rpx; font-variant-numeric: tabular-nums; }
.fact-dot { width: 5rpx; height: 5rpx; border-radius: 50%; background: #8da8bf; }
.guest-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 22rpx 4rpx 0; border-top: 1rpx solid #e4ebf1; font-size: 28rpx; line-height: 1.4; }
.created-row { margin-top: 22rpx; font-size: 24rpx; }
.row-label { flex-shrink: 0; color: #667487; }
.row-value { text-align: right; overflow-wrap: anywhere; }
.benefit-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 88rpx; margin-top: 24rpx; padding: 15rpx 18rpx; border-radius: 13rpx; background: #fff5ea; }
.benefit-copy { min-width: 0; }
.benefit-label { display: block; color: #7d4930; font-size: 26rpx; line-height: 1.3; }
.benefit-note { display: block; margin-top: 4rpx; color: #695f59; font-size: 21rpx; line-height: 1.4; }
.benefit-value { flex-shrink: 0; color: #a84b24; font-size: 29rpx; line-height: 1.3; font-weight: 700; font-variant-numeric: tabular-nums; }

.status-note { margin-top: 22rpx; text-align: center; color: #4f5f70; font-size: 25rpx; line-height: 1.45; }
.save-button { height: 88rpx; line-height: 88rpx; margin-top: 18rpx; border-radius: 14rpx; background: #a8cdef; color: #382821; font-size: 30rpx; font-weight: 700; }
.save-button:active { opacity: .82; }
.save-button.saving { background: #d3e4f3; color: #667487; }
.screenshot-hint { display: block; margin-top: 10rpx; color: #667487; font-size: 22rpx; line-height: 1.4; text-align: center; }
.demo-note { display: block; margin-top: 14rpx; color: #667487; font-size: 21rpx; line-height: 1.4; text-align: center; }
.export-canvas { position: fixed; left: -2000px; top: 0; width: 345px; height: 560px; pointer-events: none; }

@media (max-width: 340px) {
  .page { padding-left: 20rpx; padding-right: 20rpx; }
  .status-block { min-height: 228rpx; padding-left: 14rpx; }
  .status-title { font-size: 42rpx; }
  .chick { width: 255rpx; height: 255rpx; right: -4rpx; }
  .voucher { padding: 26rpx 20rpx; }
  .voucher-title { font-size: 35rpx; }
  .voucher-number { font-size: 20rpx; }
  .date-caption { font-size: 21rpx; }
  .date-main { font-size: 33rpx; }
  .date-arrow { flex-basis: 68rpx; padding: 0 9rpx; }
  .stay-facts { gap: 10rpx; font-size: 25rpx; }
  .guest-row { font-size: 27rpx; }
  .benefit-row { display: block; }
  .benefit-value { display: block; margin-top: 7rpx; font-size: 27rpx; }
}
